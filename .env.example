# ============================================================
# Creator TKS Labs — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o .env.local. Valores reais são manuseados
# manualmente pelo Jorge — nunca por ferramentas de IA.
# ============================================================

# --- Supabase (painel → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui

# SOMENTE servidor — esta chave ignora RLS. Jamais expor ao client.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# --- Provedores de IA (somente servidor) ---
GOOGLE_AI_API_KEY=coloque_a_chave_aqui
OPENAI_API_KEY=coloque_a_chave_aqui
ANTHROPIC_API_KEY=coloque_a_chave_aqui
FAL_KEY=coloque_a_chave_aqui
ELEVENLABS_API_KEY=coloque_a_chave_aqui

# --- Webhooks ---
# Segredo gerado por nós (ex.: `openssl rand -hex 32`), validado
# em toda requisição recebida em app/api/webhooks/
FAL_WEBHOOK_SECRET=gere_um_segredo_aleatorio_aqui